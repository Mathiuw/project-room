:root {
}

.container {
    align-content: flex-end;
    flex-direction: column-reverse;
    height: auto;
    width: auto;
    max-height: none;
    flex-grow: 1;
}

.unity-progress-bar {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    scale: 1 0.3;
    transform-origin: bottom;
}

.unity-progress-bar__progress {
    background-color: rgb(129, 194, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.unity-progress-bar__background {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(88, 136, 180);
}

.hidden {
    display: none;
}
