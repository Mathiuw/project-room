:root {
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 20px;
}



.unity-progress-bar {
    width: 650px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.unity-progress-bar__background {
    background-color: rgb(147, 77, 77);
    border-left-color: rgb(207, 95, 95);
    border-right-color: rgb(207, 95, 95);
    border-top-color: rgb(207, 95, 95);
    border-bottom-color: rgb(207, 95, 95);
}

.unity-progress-bar__progress {
    background-color: rgb(207, 95, 95);
}
